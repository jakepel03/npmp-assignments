 get_sim_engine_from_user (GTK_WINDOW (main_window.main_window), &(project_options.SIMULATION_ENGINE)) ;
 }  //on_simulation_engine_setup_menu_item_activate
 
+// Set every non-fixed cell back to polarization 0 (the state of a freshly drawn cell), so the
+// design no longer shows the polarization left behind by the last simulation run.
+// Fixed cells keep their polarization because it is part of the design.
+void on_reset_polarization_menu_item_activate (GtkMenuItem *menuitem, gpointer user_data)
+  {
+  GList *llItrLayer = NULL, *llItrObj = NULL ;
+  gboolean bChanged = FALSE ;
+
+  if (NULL == project_options.design) return ;
+
+  for (llItrLayer = project_options.design->lstLayers ; llItrLayer != NULL ; llItrLayer = llItrLayer->next)
+    if (LAYER_TYPE_CELLS == (QCAD_LAYER (llItrLayer->data))->type)
+      for (llItrObj = (QCAD_LAYER (llItrLayer->data))->lstObjs ; llItrObj != NULL ; llItrObj = llItrObj->next)
+        if (NULL != llItrObj->data && QCAD_IS_CELL (llItrObj->data))
+          if (QCAD_CELL_FIXED != QCAD_CELL (llItrObj->data)->cell_function)
+            {
+            qcad_cell_set_polarization (QCAD_CELL (llItrObj->data), 0.0) ;
+            bChanged = TRUE ;
+            }
+
+  if (bChanged)
+    {
+    project_options.bDesignAltered = TRUE ;
+    redraw_async (NULL) ;
+    }
+  }
